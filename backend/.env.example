# SpikeClip web API — environment. Set these on the host (Render), not in git.

# Database. Postgres in production (e.g. a free Neon database). Without it
# the SQLite file is lost every time a free host restarts or redeploys.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Owner token for /admin/* (issue / revoke keys by hand). Long and random.
# The old SPIKECLIP_API_TOKEN variable is accepted too.
ADMIN_TOKEN=

# Website origin(s), comma-separated. SPIKECLIP_CORS_ORIGINS is accepted too.
CORS_ORIGINS=https://spikeclip-app.vercel.app

# Sign-up: open | invite | closed
SIGNUP=open

# Paddle. The client token and price ids have built-in defaults (app/paddle.py).
PADDLE_WEBHOOK_SECRET=
WHOP_WEBHOOK_SECRET=

# Desktop builds offered on the account page.
DOWNLOAD_WINDOWS_URL=
DOWNLOAD_MAC_URL=
APP_VERSION=2.1.0
