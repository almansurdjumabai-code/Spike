# SpikeClip backend — environment for a cloud deployment.
# Copy to .env (never commit the real one) or set these in your host's dashboard.

# Required on any public server. A long random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Every request must carry it (Authorization: Bearer <token>); the web
# frontend asks for it once and keeps it in the browser.
SPIKECLIP_API_TOKEN=

# Origin(s) of the deployed frontend, comma-separated, no trailing slash.
SPIKECLIP_CORS_ORIGINS=https://app.example.com

# Host name(s) this API is reached by, comma-separated.
SPIKECLIP_ALLOWED_HOSTS=api.example.com

# Where videos, clips and the SQLite database live. Mount a persistent disk here.
SPIKECLIP_DATA_DIR=/data

# Port: most platforms set PORT themselves; 8765 otherwise.
# PORT=8765

# The LLM that scores clips. Either an Ollama server reachable from here...
SPIKECLIP_OLLAMA_HOST=http://ollama:11434
# ...or a cloud provider chosen in Settings → AI (OpenRouter is the easy one).

# Optional: shown in bug reports; set by the Docker build arg of the same name.
# SPIKECLIP_VERSION=2.1.0
