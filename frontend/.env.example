# SpikeClip frontend — build-time settings for the web build (npm run build:web).
# Copy to .env.production (or set in Vercel / Netlify / Cloudflare Pages).
# These are baked into the static files: never put secrets here.

# Public address of the SpikeClip backend, no trailing slash.
# Left unset, the app talks to a desktop engine at http://127.0.0.1:8765.
VITE_API_BASE=https://api.example.com
